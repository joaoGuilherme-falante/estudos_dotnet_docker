# Local development only. Replace every value before using this setup.
POSTGRES_DB=taskflow
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=replace-with-a-local-db-password
JWT_KEY=replace-with-a-random-secret-at-least-32-bytes-long
JWT_ISSUER=TaskFlow
JWT_AUDIENCE=TaskFlow.Client
JWT_EXPIRES_IN_MINUTES=60
BOOTSTRAP_ADMIN_NAME=TaskFlow Admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.local
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-admin-password
